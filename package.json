{
  "name": "fubao",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro check && astro build",
    "check": "astro check",
    "preview": "astro preview --host 127.0.0.1",
    "test": "vitest run",
    "db:migrate": "wrangler d1 migrations apply fubao --local",
    "db:migrate:remote": "wrangler d1 migrations apply fubao --remote",
    "db:init": "tsx scripts/init-user.ts",
    "data:sync:fitness": "tsx scripts/import-exercises.ts",
    "data:sync:locations": "tsx scripts/import-locations.ts",
    "data:sync:map": "tsx scripts/import-map.ts",
    "deploy": "pnpm build && wrangler deploy",
    "deploy:ci": "wrangler d1 migrations apply fubao --remote && wrangler deploy",
    "data:sync:scenic": "tsx scripts/import-scenic.ts",
    "data:sync:scenery": "tsx scripts/sync-scenery.ts",
    "data:sync:fitness-media": "tsx scripts/sync-exercise-media.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.3.1",
    "@astrojs/react": "6.0.5",
    "@noble/hashes": "2.4.0",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-slot": "1.3.3",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "d3-geo": "3.1.1",
    "d3-selection": "3.0.0",
    "d3-zoom": "3.0.0",
    "exifr": "7.1.3",
    "lucide-react": "1.43.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/workers-types": "5.20260908.1",
    "@playwright/test": "1.63.0",
    "@types/d3-geo": "3.1.1",
    "@types/d3-selection": "3.0.11",
    "@types/d3-zoom": "3.0.8",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "1.0.0",
    "sharp": "0.35.4",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "5.0.0",
    "wrangler": "4.130.0"
  }
}
