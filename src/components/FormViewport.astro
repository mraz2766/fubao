<script>
  const viewport = window.visualViewport;
  const sync = () => {
    if (!document.querySelector('.task-form') || !viewport) return;
    const inset = Math.max(0, window.innerHeight - viewport.height - viewport.offsetTop);
    document.documentElement.style.setProperty('--keyboard-bottom', `${inset}px`);
    document.documentElement.toggleAttribute('data-keyboard', inset > 100);
    const field = document.activeElement;
    if (
      inset > 100 &&
      (field instanceof HTMLInputElement || field instanceof HTMLTextAreaElement)
    ) {
      const bounds = field.getBoundingClientRect();
      const bottom = viewport.offsetTop + viewport.height - 90;
      if (bounds.bottom > bottom || bounds.top < viewport.offsetTop + 52)
        field.scrollIntoView({ block: 'center', behavior: 'instant' });
    }
  };
  viewport?.addEventListener('resize', sync);
  document.addEventListener('focusin', sync);
</script>
