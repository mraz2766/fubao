---
// Adapted from Animata Tilted Cover, MIT. Keyboard and touch share the same destination.
const { href, src, alt, label } = Astro.props as {
  href: string;
  src: string;
  alt: string;
  label: string;
};
---

<a href={href} class="animata-cover">
  <span class="cover-back" aria-hidden="true"></span>
  <span class="cover-photo">
    <img src={src} alt={alt} width="640" height="360" decoding="async" />
    <span class="cover-caption">
      {label}
      <span aria-hidden="true">↗</span>
    </span>
  </span>
</a>
