---
import type { FitnessSet, Preferences, Locale } from '../../types/domain';
import { toDisplayWeight, toDisplayDistance } from '../../lib/analytics';
const { sets, preferences, locale } = Astro.props as {
  sets: FitnessSet[];
  preferences: Preferences;
  locale: Locale;
};
const zh = locale === 'zh-CN';
// Only combine adjacent identical sets; individual notes and effort scores remain visible.
const groups: { set: FitnessSet; count: number }[] = [];
for (const set of sets) {
  const previous = groups.at(-1);
  const equal =
    previous &&
    ['weight', 'reps', 'duration', 'distance', 'rpe', 'note', 'completed'].every(
      (k) => previous.set[k as keyof FitnessSet] === set[k as keyof FitnessSet],
    );
  if (equal) previous.count++;
  else groups.push({ set, count: 1 });
}
const text = (s: FitnessSet) =>
  [
    s.weight !== null
      ? `${Number(toDisplayWeight(s.weight, preferences.weightUnit).toFixed(2))} ${preferences.weightUnit}`
      : '',
    s.reps !== null ? `${s.reps} ${zh ? '次' : 'reps'}` : '',
    s.duration !== null ? `${s.duration} ${zh ? '秒' : 'sec'}` : '',
    s.distance !== null
      ? `${Number(toDisplayDistance(s.distance, preferences.distanceUnit).toFixed(2))} ${preferences.distanceUnit}`
      : '',
  ]
    .filter(Boolean)
    .join(' × ') || (zh ? '未填写数值' : 'No measurements');
---

{groups.map(({ set, count }) => (
  <div class="workout-set-summary">
    <p>
      {text(set)}
      {count > 1 && (
        <>
          {' '}
          × {count} {zh ? '组' : 'sets'}
        </>
      )}
    </p>
    {(set.rpe !== null || !set.completed) && (
      <small class="muted">
        {set.rpe !== null ? `RPE ${set.rpe}` : ''}
        {!set.completed ? (zh ? ' · 未完成' : ' · Incomplete') : ''}
      </small>
    )}
    {set.note && <p class="small muted">{set.note}</p>}
  </div>
))}
