---
import '../styles/global.css';
import { House, Dumbbell, MapPin, Settings, ArrowUpRight } from 'lucide-react';
import { translator } from '../lib/i18n';
const { title, active = 'home' } = Astro.props;
const locale = Astro.locals.locale ?? 'zh-CN';
const t = translator(locale);
const nav = [
  ['home', '/', House],
  ['fitness', '/fitness', Dumbbell],
  ['travel', '/travel', MapPin],
  ['settings', '/settings', Settings],
] as const;
---

<!doctype html>
<html lang={locale} data-preferred-theme={Astro.locals.preferences.theme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#f6f7f8" />
    <meta name="description" content={t('app.tagline')} />
    <title>{title} · Fubao</title>
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icon-192.png" />
    <script is:inline>
      (() => {
        try {
          const p = { theme: document.documentElement.dataset.preferredTheme || 'system' };
          document.documentElement.dataset.theme =
            p.theme === 'dark' ||
            ((!p.theme || p.theme === 'system') &&
              matchMedia('(prefers-color-scheme: dark)').matches)
              ? 'dark'
              : 'light';
          document
            .querySelector('meta[name="theme-color"]')
            ?.setAttribute(
              'content',
              document.documentElement.dataset.theme === 'dark' ? '#151618' : '#f6f7f8',
            );
        } catch {}
      })();
    </script>
  </head>
  <body data-page={active}>
    <a class="skip-link" href="#main">
      {locale === 'zh-CN' ? '跳转至内容' : 'Skip to content'}
    </a>
    <aside class="sidebar">
      <a href="/" class="brand" aria-label="Fubao">
        <span class="brand-mark" aria-hidden="true">
          f
        </span>
        <span>fubao.</span>
      </a>
      <nav aria-label={t('app.tagline')}>
        {nav.map(([key, href, Icon]) => (
          <a
            href={href}
            class:list={['nav-item', { active: active === key }]}
            aria-current={active === key ? 'page' : undefined}
          >
            <Icon size={19} strokeWidth={1.6} />
            <span>{t(`nav.${key}`)}</span>
          </a>
        ))}
      </nav>
      <div class="sidebar-bottom">
        <a class="text-link" href={Astro.locals.user ? '/settings' : '/login'}>
          {Astro.locals.user?.username ?? t('auth.login')}
          <ArrowUpRight size={14} />
        </a>
      </div>
    </aside>
    <div class="mobile-header">
      <a href="/" class="brand">
        <span class="brand-mark" aria-hidden="true">
          f
        </span>
        fubao.
      </a>
      <a class="text-link" href={Astro.locals.user ? '/settings' : '/login'}>
        {Astro.locals.user?.username ?? t('auth.login')}
        <ArrowUpRight size={14} />
      </a>
    </div>
    <main id="main" class="main">
      <slot />
    </main>
    <nav class="mobile-nav" aria-label={t('app.tagline')}>
      {nav.map(([key, href, Icon]) => (
        <a
          href={href}
          class:list={['nav-item', { active: active === key }]}
          aria-current={active === key ? 'page' : undefined}
        >
          <Icon size={21} strokeWidth={1.6} />
          <span>{t(`nav.${key}`)}</span>
        </a>
      ))}
    </nav>
    <script>
      if (import.meta.env.PROD && 'serviceWorker' in navigator)
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      document.addEventListener('click', (event) => {
        for (const menu of document.querySelectorAll<HTMLDetailsElement>('.view-menu[open]')) {
          if (event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
        }
      });
      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return;
        const menu = document.querySelector<HTMLDetailsElement>('.view-menu[open]');
        if (menu) {
          event.preventDefault();
          menu.open = false;
          menu.querySelector('summary')?.focus();
        }
      });
      const media = matchMedia('(prefers-color-scheme: dark)');
      media.addEventListener('change', () => {
        try {
          const p = { theme: document.documentElement.dataset.preferredTheme || 'system' };
          if (!p.theme || p.theme === 'system')
            document.documentElement.dataset.theme = media.matches ? 'dark' : 'light';
        } catch {}
      });
    </script>
  </body>
</html>
