---
import geometry from '../../data/world-paths.json';
const {
  visited = [],
  wishlist = [],
  compact = false,
} = Astro.props as { visited?: string[]; wishlist?: string[]; compact?: boolean };
---

<svg viewBox="0 0 800 390" class:list={['world-map', { compact }]} aria-hidden="true">
  <g>
    {geometry.countries.map((f) => (
      <use
        href={compact ? undefined : `${geometry.asset}#country-${f.code}`}
        data-map-href={compact ? `${geometry.asset}#country-${f.code}` : undefined}
        class:list={[
          'country',
          {
            visited: visited.includes(String(f.code)),
            wish: wishlist.includes(String(f.code)),
          },
        ]}
      />
    ))}
  </g>
</svg>
<style>
  .world-map {
    width: 100%;
    height: auto;
    display: block;
  }
  .country {
    fill: var(--map-land);
    stroke: var(--surface);
    stroke-width: 0.7;
    stroke-linejoin: round;
  }
  .country.visited {
    fill: var(--accent);
  }
  .country.wish {
    stroke: var(--accent);
    stroke-width: 1.5;
    fill: var(--surface);
  }
  .compact {
    max-height: 210px;
  }
</style>

<script>
  // Hidden maps do not compete with the first-screen photo for network bandwidth.
  document.querySelectorAll<HTMLDetailsElement>('.dashboard-map').forEach((details) => {
    const load = () => {
      if (details.open)
        details.querySelectorAll<SVGUseElement>('[data-map-href]').forEach((use) => {
          use.setAttribute('href', use.dataset.mapHref!);
          delete use.dataset.mapHref;
        });
    };
    details.addEventListener('toggle', load);
    load();
  });
</script>
