---
import { geoNaturalEarth1, geoPath } from 'd3-geo';
import world from '../../data/world.json';
import type { GeoPermissibleObjects } from 'd3-geo';
const {
  visited = [],
  wishlist = [],
  compact = false,
} = Astro.props as { visited?: string[]; wishlist?: string[]; compact?: boolean };
const projection = geoNaturalEarth1().fitExtent(
  [
    [8, 8],
    [792, 382],
  ],
  world as unknown as GeoPermissibleObjects,
);
const path = geoPath(projection);
---

<svg viewBox="0 0 800 390" class:list={['world-map', { compact }]} aria-hidden="true">
  <g>
    {world.features.map((f) => (
      <path
        d={path(f as unknown as GeoPermissibleObjects) ?? ''}
        class:list={[
          'country',
          {
            visited: visited.includes(String(f.properties.code)),
            wish: wishlist.includes(String(f.properties.code)),
          },
        ]}
      />
    ))}
  </g>
</svg>
<style>
  .world-map {
    width: 100%;
    height: auto;
    display: block;
  }
  .country {
    fill: var(--map-land);
    stroke: var(--surface);
    stroke-width: 0.7;
    stroke-linejoin: round;
  }
  .country.visited {
    fill: var(--accent);
  }
  .country.wish {
    stroke: var(--accent);
    stroke-width: 1.5;
    fill: var(--surface);
  }
  .compact {
    max-height: 210px;
  }
</style>
