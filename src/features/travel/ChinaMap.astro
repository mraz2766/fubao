---
import { geoMercator, geoPath, type GeoPermissibleObjects } from 'd3-geo';
import world from '../../data/world.json';
import spots from '../../data/scenic-spots.json';
import type { Locale, Trip, Wish } from '../../types/domain';
import { translator } from '../../lib/i18n';
const { locale, trips, wishes } = Astro.props as { locale: Locale; trips: Trip[]; wishes: Wish[] };
const t = translator(locale);
const china = world.features.find((f) => f.properties.code === 'CN')!;
const projection = geoMercator().fitExtent(
  [
    [35, 25],
    [745, 495],
  ],
  china as unknown as GeoPermissibleObjects,
);
const outline = geoPath(projection)(china as unknown as GeoPermissibleObjects);
---

<div class="china-map">
  <div class="card-heading">
    <div>
      <span class="eyebrow">{t('travel.domestic')}</span>
      <h2>{t('travel.chinaMap')}</h2>
    </div>
    <a class="text-link" href="/travel?view=map&scope=world">
      {t('travel.worldMap')} ↗
    </a>
  </div>
  <svg viewBox="0 0 780 520" role="img" aria-label={t('travel.chinaMap')}>
    <path d={outline} fill="var(--accent-soft)" stroke="var(--map-land)" stroke-width="1.2" />
    {spots.map((s) => {
      const [x, y] = projection([s.longitude, s.latitude])!;
      const visited = trips.some((t) => t.spot_id === s.id),
        wish = wishes.some((w) => w.spot_id === s.id);
      return (
        <a
          href={`/travel?view=discover&spot=${s.id}`}
          aria-label={locale === 'zh-CN' ? s.name_zh : s.name_en}
        >
          <circle cx={x} cy={y} r="14" fill="transparent" />
          <circle
            cx={x}
            cy={y}
            r={visited ? 6 : 4}
            fill={visited ? 'var(--accent)' : wish ? 'var(--surface)' : 'var(--map-land)'}
            stroke="var(--accent)"
            stroke-width={wish ? 2 : 0}
          />
          <title>{locale==='zh-CN'?s.name_zh:s.name_en}</title>
        </a>
      );
    })}
  </svg>
  <p class="small muted">{t('travel.chinaMapHint')}</p>
  <div class="map-place-list">
    {spots.map((s) => {
      const visited = trips.some((trip) => trip.spot_id === s.id);
      const wanted = wishes.some((wish) => wish.spot_id === s.id);
      return (
        <a href={`/travel?view=discover&spot=${s.id}`}>
          <span>{locale === 'zh-CN' ? s.name_zh : s.name_en}</span>
          <span class="small muted">
            {visited
              ? t('travel.visited')
              : wanted
                ? t('travel.want')
                : locale === 'zh-CN'
                  ? s.region
                  : s.region_en}{' '}
            ↗
          </span>
        </a>
      );
    })}
  </div>
</div>
