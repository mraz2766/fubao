---
import geometry from '../../data/china-map.json';
import { chinaPlaces } from './china-places';
import type { Locale, Trip, Wish } from '../../types/domain';
import { translator } from '../../lib/i18n';
const { locale, trips, wishes } = Astro.props as { locale: Locale; trips: Trip[]; wishes: Wish[] };
const t = translator(locale),
  places = chinaPlaces(trips, wishes, locale);
---

<div class="china-map">
  <div class="card-heading">
    <h2>{t('travel.chinaMap')}</h2>
    <a class="text-link" href="/travel?view=map&scope=world">
      {t('travel.worldMap')} ↗
    </a>
  </div>
  <svg viewBox="0 0 780 520" role="group" aria-label={t('travel.chinaMap')}>
    <path
      d={geometry.path}
      fill="var(--surface-soft)"
      stroke="var(--map-land)"
      stroke-width="1.2"
    />
    {places
      .filter((p) => p.point)
      .map((p) => (
        <a
          href={p.href}
          aria-label={p.name + ' · ' + t(p.visited ? 'travel.visited' : 'travel.want')}
        >
          <circle cx={p.point![0]} cy={p.point![1]} r="22" fill="transparent" />
          <circle
            cx={p.point![0]}
            cy={p.point![1]}
            r="6"
            fill={p.visited ? 'var(--accent)' : 'var(--surface)'}
            stroke="var(--accent)"
            stroke-width="2"
          />
          <title>{p.name}</title>
        </a>
      ))}
  </svg>
  {!places.length && <p class="muted">{t('travel.noTrips')}</p>}
  <nav class="map-place-list" aria-label={t('quiet.savedLocations')}>
    {places.map((p) => (
      <a href={p.href}>
        <span>{p.name}</span>
        <span class="small muted">
          {t(p.visited ? 'travel.visited' : 'travel.want')}
          {!p.point && ' · ' + t('quiet.noCoordinates')} ↗
        </span>
      </a>
    ))}
  </nav>
</div>
