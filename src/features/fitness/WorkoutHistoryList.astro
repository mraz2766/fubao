---
import type { Workout, Locale, Preferences } from '../../types/domain';
import { workoutDay, knownWorkoutSeconds } from '../../lib/analytics';
import { translator } from '../../lib/i18n';
import StoryIcon from '../../components/illustrations/StoryIcon';
import { ChevronRight } from 'lucide-react';
const { workouts, locale, preferences } = Astro.props as {
  workouts: Workout[];
  locale: Locale;
  preferences: Preferences;
};
const t = translator(locale);
const groups = new Map<string, Workout[]>();
for (const w of workouts) {
  const day = workoutDay(w, preferences.timezone);
  groups.set(day, [...(groups.get(day) ?? []), w]);
}
---

<div class="workout-history">
  {[...groups].map(([day, items]) => (
    <section class="history-day">
      <h3 class="muted small">
        <time datetime={day}>{day}</time>
      </h3>
      <div class="workout-list">
        {items.map((w) => (
          <a class="workout-card card-link" href={`/fitness/${w.id}`}>
            <StoryIcon kind="fitness" size={26} />
            <div class="workout-content">
              <h3>
                {w.body_parts.length
                  ? w.body_parts.map((p) => t(`fitness.${p}` as 'fitness.back')).join(' · ')
                  : w.title}
              </h3>
              <p class="muted small">
                {knownWorkoutSeconds(w) !== null
                  ? `${Math.round(knownWorkoutSeconds(w)! / 60)} ${t('common.minutes')} · `
                  : ''}
                {w.exercises.length} {t('ia.exerciseCount')}
                {w.status !== 'completed' ? ` · ${t(`fitness.${w.status}`)}` : ''}
              </p>
            </div>
            <ChevronRight size={17} />
          </a>
        ))}
      </div>
    </section>
  ))}
</div>
