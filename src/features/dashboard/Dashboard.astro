---
import { Dumbbell, MapPin, Plus, Clock3 } from 'lucide-react';
import { translator } from '../../lib/i18n';
import { fitnessSummary, knownWorkoutSeconds } from '../../lib/analytics';
import { tripName } from '../../lib/travel-presentation';
import type { Locale, Preferences, Widget, Workout, Trip } from '../../types/domain';
const {
  workouts,
  trips,
  widgets,
  preferences,
  locale,
  owner = false,
  places = 0,
} = Astro.props as {
  workouts: Workout[];
  trips: Trip[];
  widgets: Widget[];
  preferences: Preferences;
  locale: Locale;
  owner?: boolean;
  places?: number;
  feedbackScope?: string;
};
const t = translator(locale),
  summary = fitnessSummary(workouts, preferences);
const latest = workouts.find((w) => w.status === 'completed'),
  today = summary.todayWorkouts[0],
  trip = trips[0];
const name = (w: Workout) =>
  w.body_parts.length ? w.body_parts.map((p) => t(`fitness.${p as 'back'}`)).join(' · ') : w.title;
const visible = widgets
  .filter((w) => w.visible && ['fitness', 'travel'].includes(w.key))
  .sort((a, b) => a.order - b.order);
---

<div class="home-pair home-bento">
  {visible.map((widget, index) => (
    <section
      class:list={['home-life-card', 'dashboard-' + widget.key]}
      style={`--entry-order:${index}`}
    >
      <h2>
        <span class="life-icon">
          {widget.key === 'fitness' ? <Dumbbell size={23} /> : <MapPin size={23} />}
        </span>
        {t(widget.key === 'fitness' ? 'nav.fitness' : 'nav.travel')}
      </h2>
      {widget.key === 'fitness' ? (
        <>
          <h3>{today ? name(today) : t('dashboard.noWorkout')}</h3>
          <p>
            {t('dashboard.week')} <strong>{summary.weekCount}</strong> {t('common.times')}
          </p>
          {latest && (
            <p class="life-recent">
              <Clock3 size={16} />
              <span>
                {t('inline.recent')}：{name(latest)}
                {knownWorkoutSeconds(latest) !== null &&
                  ` · ${Math.round(knownWorkoutSeconds(latest)! / 60)} ${t('common.minutes')}`}
              </span>
            </p>
          )}
        </>
      ) : (
        <>
          {trip ? (
            <a href={`/travel/${trip.id}`} class="life-photo">
              <img
                src={`/api/media/${trip.photos[0]?.id}/thumbnail`}
                alt={tripName(trip, locale)}
                width="480"
                height="300"
                decoding="async"
                sizes="(max-width:767px) 90vw, 40vw"
              />
              <span>
                <strong>{tripName(trip, locale)}</strong>
                {trip.start_date && (
                  <time datetime={trip.start_date}>
                    {trip.start_date.slice(0, 7).replace('-', '.')}
                  </time>
                )}
              </span>
            </a>
          ) : (
            <p class="muted">{t('travel.noTrips')}</p>
          )}
          {places > 0 && (
            <p class="small muted">
              {places} {t('inline.places')}
            </p>
          )}
        </>
      )}
      {owner && (
        <a
          class="button button-secondary life-record"
          href={widget.key === 'fitness' ? '/fitness#record' : '/travel#record'}
        >
          <Plus size={17} />
          {t(widget.key === 'fitness' ? 'inline.workout' : 'travel.add')}
        </a>
      )}
    </section>
  ))}
</div>
