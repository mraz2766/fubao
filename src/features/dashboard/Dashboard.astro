---
import { ArrowUpRight, Dumbbell, MapPin, Check } from 'lucide-react';
import { translator } from '../../lib/i18n';
import { fitnessSummary } from '../../lib/analytics';
import type { Locale, Preferences, Widget, Workout, Trip } from '../../types/domain';
const {
  workouts = [],
  trips = [],
  widgets,
  preferences,
  locale,
  owner = false,
} = Astro.props as {
  workouts: Workout[];
  trips: Trip[];
  widgets: Widget[];
  preferences: Preferences;
  locale: Locale;
  owner?: boolean;
};
const t = translator(locale),
  summary = fitnessSummary(workouts, preferences),
  today = summary.todayWorkouts[0];
const recentWorkout = workouts.find((w) => w.status === 'completed'),
  recentTrip = trips[0];
const tripName = (trip: Trip) =>
  locale === 'zh-CN' ? trip.location.name_zh || trip.location.name : trip.location.name;
const dateText = (
  date: string,
  opts: Intl.DateTimeFormatOptions = { month: 'short', day: 'numeric' },
) =>
  new Intl.DateTimeFormat(locale, { timeZone: preferences.timezone, ...opts }).format(
    new Date(date),
  );
---

<div class="bento">
  {widgets
    .filter((w) => w.visible)
    .sort((a, b) => a.order - b.order)
    .map((widget) => (
      <section class:list={['card', 'widget-' + widget.size, 'dashboard-' + widget.key]}>
        {widget.key === 'fitness' && (
          <>
            <div class="card-heading">
              <h2>
                <span class="dashboard-marker">
                  <Dumbbell size={16} aria-hidden="true" />
                </span>
                {t('dashboard.fitness')}
              </h2>
              <a
                href="/fitness"
                class="button button-ghost button-icon"
                aria-label={t('fitness.title')}
              >
                <ArrowUpRight size={18} />
              </a>
            </div>
            <a class="today-workout" href={today ? '/fitness/' + today.id : '/fitness'}>
              <span class="small muted">{t('common.today')}</span>
              <h3>{today?.title ?? t('dashboard.noWorkout')}</h3>
              {today && today.time_precision !== 'date' && (
                <p class="muted small">
                  {dateText(today.start_at, { hour: '2-digit', minute: '2-digit' })}
                  {today.end_at &&
                    ' – ' + dateText(today.end_at, { hour: '2-digit', minute: '2-digit' })}
                </p>
              )}
            </a>
            <div class="week-summary">
              <span>
                {t('dashboard.week')} <strong>{summary.weekCount}</strong> {t('common.times')}
              </span>
              <span class="muted small">
                {t('quiet.goal')} {preferences.weeklyGoal} {t('common.times')}
              </span>
            </div>
          </>
        )}
        {widget.key === 'travel' && (
          <>
            <div class="card-heading">
              <h2>
                <span class="dashboard-marker">
                  <MapPin size={16} aria-hidden="true" />
                </span>
                {t('dashboard.travel')}
              </h2>
              <a
                href="/travel"
                class="button button-ghost button-icon"
                aria-label={t('travel.title')}
              >
                <ArrowUpRight size={18} />
              </a>
            </div>
            {recentTrip ? (
              <a href={'/travel/' + recentTrip.id} class="dashboard-photo">
                <img
                  src={'/api/media/' + recentTrip.photos[0]?.id + '/thumbnail'}
                  alt={tripName(recentTrip)}
                  width="480"
                  height="300"
                  decoding="async"
                  loading="eager"
                  sizes="(max-width:767px) 90vw, 40vw"
                />
                <div class="photo-description">
                  <h3>{tripName(recentTrip)}</h3>
                  <span class="small muted">{recentTrip.start_date ?? t('common.undated')}</span>
                </div>
              </a>
            ) : (
              <div class="dashboard-empty">
                <MapPin size={24} strokeWidth={1.5} />
                <p>{t('dashboard.noTravel')}</p>
                <a class="text-link" href={owner ? '/travel?new=1' : '/travel'}>
                  {t(owner ? 'travel.add' : 'travel.timeline')} <ArrowUpRight size={15} />
                </a>
              </div>
            )}
          </>
        )}
        {widget.key === 'weekly' && (
          <>
            <div class="card-heading">
              <h2>{t('dashboard.weekly')}</h2>
              <span class="small muted">{dateText(summary.weekStart + 'T12:00:00Z')}</span>
            </div>
            <div class="weekly-dots">
              {summary.days.map(({ day, trained }) => (
                <a
                  href={'/fitness?day=' + day}
                  class:list={['week-day', { today: day === summary.today }]}
                  aria-label={day + ' · ' + t(trained ? 'dashboard.trained' : 'dashboard.rest')}
                >
                  <span>{dateText(day + 'T12:00:00Z', { weekday: 'narrow' })}</span>
                  <span class:list={['day-dot', { trained }]}>
                    {trained ? <Check size={13} /> : <span aria-hidden="true">·</span>}
                  </span>
                  <span>{Number(day.slice(8))}</span>
                </a>
              ))}
            </div>
          </>
        )}
        {widget.key === 'recent' && (
          <>
            <div class="card-heading">
              <h2>{t('dashboard.recent')}</h2>
            </div>
            {recentWorkout && (
              <a class="recent-row" href={'/fitness/' + recentWorkout.id}>
                <Dumbbell size={18} className="muted" />
                <div class="recent-info">
                  <h3>{recentWorkout.title}</h3>
                  <span class="small muted">
                    {recentWorkout.time_precision === 'date'
                      ? recentWorkout.workout_date
                      : dateText(recentWorkout.start_at)}
                  </span>
                </div>
                <ArrowUpRight size={16} />
              </a>
            )}
            {recentTrip && (
              <a class="recent-row" href={'/travel/' + recentTrip.id}>
                <MapPin size={18} className="muted" />
                <div class="recent-info">
                  <h3>{tripName(recentTrip)}</h3>
                  <span class="small muted">{recentTrip.start_date ?? t('common.undated')}</span>
                </div>
                <ArrowUpRight size={16} />
              </a>
            )}
            {!recentWorkout && !recentTrip && <p class="muted small">{t('dashboard.noRecent')}</p>}
          </>
        )}
      </section>
    ))}
</div>
