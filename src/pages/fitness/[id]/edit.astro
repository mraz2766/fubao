---
import FormViewport from '../../../components/FormViewport.astro';
import Base from '../../../layouts/Base.astro';
import WorkoutFormPage from '../../../features/fitness/WorkoutFormPage';
import { listWorkouts } from '../../../server/services/fitness';
import { translator } from '../../../lib/i18n';
const { user, locale, preferences } = Astro.locals;
if (!user) return Astro.redirect('/login');
const initial = (await listWorkouts(user, Astro.params.id))[0],
  t = translator(locale);
if (!initial) return Astro.redirect('/404');
---

<Base title={t('ia.editWorkout')} active="fitness">
  <a class="text-link" href={`/fitness/${initial.id}`}>
    ← {t('ia.workoutDetail')}
  </a>
  <header class="page-header">
    <h1>{t('ia.editWorkout')}</h1>
  </header>
  <WorkoutFormPage locale={locale} preferences={preferences} initial={initial} client:load />
<FormViewport /></Base>
