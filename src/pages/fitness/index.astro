---
import { fitnessOverview } from '../../server/services/fitness-overview';
import { ProgressBar } from '../../components/ui/progress-bar';
import WorkoutHistoryList from '../../features/fitness/WorkoutHistoryList.astro';
import Base from '../../layouts/Base.astro';
import TodayWorkout from '../../components/app/TodayWorkout.astro';

import ExerciseSearch from '../../features/fitness/ExerciseSearch';
import HistoryCalendar from '../../features/fitness/HistoryCalendar';
import Templates from '../../features/fitness/Templates';
import { translator, exerciseName, taxonomyLabel } from '../../lib/i18n';
import {
  dayKey,
  workoutDay,
  knownWorkoutSeconds,
  fitnessSummary,
  workoutSeconds,
  workoutVolume,
  personalRecords,
  muscleDistribution,
  toDisplayWeight,
} from '../../lib/analytics';
import { listWorkouts, listTemplates } from '../../server/services/fitness';
import { ArrowUpRight, Dumbbell } from 'lucide-react';
const { locale, preferences, user } = Astro.locals,
  t = translator(locale);
const view =
    Astro.url.searchParams.get('view') ?? (Astro.url.searchParams.has('day') ? 'history' : 'today'),
  selected = Astro.url.searchParams.get('day') ?? undefined;
const catalogCount =
  view === 'library'
    ? await (
        await import('../../server/db')
      ).first<{ count: number }>('SELECT COUNT(*) count FROM exercise_library WHERE active=1')
    : null;
const overview = view === 'today' ? await fitnessOverview(user, preferences) : null;
const recordPage = Math.max(0, Number(Astro.url.searchParams.get('page')) || 0);
const workouts = overview
    ? await listWorkouts(user, undefined, { limit: 21, offset: recordPage * 20 })
    : ['history', 'analytics'].includes(view)
      ? await listWorkouts(user)
      : [],
  summary = fitnessSummary(overview?.workouts ?? workouts, preferences);
const todayWorkouts = overview
  ? (
      await Promise.all(
        overview.workouts
          .filter((w) => workoutDay(w, preferences.timezone) === overview.today)
          .map((w) => {
            const loaded = workouts.find((item) => item.id === w.id);
            return loaded ? [loaded] : listWorkouts(user, w.id);
          }),
      )
    ).flat()
  : [];
const filtered = selected
  ? workouts.filter((w) => workoutDay(w, preferences.timezone) === selected)
  : workouts;
const page = Math.max(0, Number(Astro.url.searchParams.get('page')) || 0),
  visible = filtered.slice(page * 20, page * 20 + 20);
const days: Record<
  string,
  {
    count: number;
    minutes: number;
    durationKnown?: boolean;
    volume: number;
    sets: number;
    exercises: number;
  }
> = {};
for (const w of (view === 'history' ? workouts : []).filter((w) => w.status === 'completed')) {
  const key = workoutDay(w, preferences.timezone),
    current = days[key] ?? { count: 0, minutes: 0, volume: 0, sets: 0, exercises: 0 };
  days[key] = {
    count: current.count + 1,
    minutes: current.minutes + workoutSeconds(w) / 60,
    durationKnown: !!current.durationKnown || knownWorkoutSeconds(w) !== null,
    volume: current.volume + workoutVolume(w),
    sets:
      current.sets + w.exercises.reduce((n, e) => n + e.sets.filter((s) => s.completed).length, 0),
    exercises: current.exercises + w.exercises.length,
  };
}
const isView = (name: string) => view === name;
const period = Astro.url.searchParams.get('period') === '7' ? 7 : 30;
const muscles =
    view === 'analytics' ? muscleDistribution(workouts, preferences.timezone, period) : [],
  records = view === 'analytics' ? personalRecords(workouts) : [];
---

<Base title={t('nav.fitness')} active="fitness">
  <header class="page-header">
    <div>
      <h1>{locale === 'zh-CN' ? '训练' : 'Training'}</h1>
    </div>
  </header>
  <details class="view-menu">
    <summary>{locale === 'zh-CN' ? '更多训练工具' : 'Training tools'}</summary>
    <nav class="secondary-links" aria-label={t('nav.fitness')}>
      {(
        [
          ['today', 'fitness.history'],
          ['history', 'fitness.history'],
          ['analytics', 'fitness.analytics'],
          ['templates', 'fitness.templates'],
          ['library', 'fitness.library'],
        ] as const
      ).map(([key, label]) => (
        <a
          class:list={{ active: view === key || (key === 'today' && view === 'history') }}
          href={`/fitness?view=${key}`}
        >
          {key === 'history' ? (locale === 'zh-CN' ? '按日期查看' : 'Calendar') : t(label)}
        </a>
      ))}
    </nav>
  </details>
  {isView('today') && (
    <section class="fitness-workspace">
      <TodayWorkout workouts={todayWorkouts} locale={locale} owner={!!user} />
      <h2 class="section-title">{locale === 'zh-CN' ? '最近训练' : 'Recent workouts'}</h2>
      <WorkoutHistoryList
        workouts={workouts.slice(0, 20)}
        locale={locale}
        preferences={preferences}
      />
      <div class="form-actions">
        {recordPage > 0 && (
          <a class="button button-secondary" href={`/fitness?page=${recordPage - 1}`}>
            {t('common.previous')}
          </a>
        )}
        {workouts.length > 20 && (
          <a class="button button-secondary" href={`/fitness?page=${recordPage + 1}`}>
            {t('common.next')}
          </a>
        )}
      </div>
      {!workouts.length && <p class="muted">{t('dashboard.noWorkout')}</p>}
    </section>
  )}
  {isView('history') && (
    <>
      <HistoryCalendar
        locale={locale}
        weekStart={preferences.weekStart}
        today={summary.today}
        days={days}
        selected={selected}
        client:visible
      />
      {selected && (
        <div class="card-heading">
          <h2>{selected}</h2>
          <a class="text-link" href="/fitness?view=history">
            {t('common.all')}
          </a>
        </div>
      )}
      <div class="workout-list">
        {visible.map((w) => (
          <a class="workout-card card-link" href={`/fitness/${w.id}`}>
            <span class="workout-date">
              <strong>
                {new Intl.DateTimeFormat(locale, {
                  day: 'numeric',
                  timeZone: preferences.timezone,
                }).format(new Date(w.start_at))}
              </strong>
              <span>
                {new Intl.DateTimeFormat(locale, {
                  month: 'short',
                  timeZone: preferences.timezone,
                }).format(new Date(w.start_at))}
              </span>
            </span>
            <div class="workout-content">
              <h3>{w.title}</h3>
              <div class="workout-meta">
                <span>
                  {knownWorkoutSeconds(w) === null
                    ? t('simple.notRecorded')
                    : `${Math.round(workoutSeconds(w) / 60)} ${t('common.minutes')}`}
                </span>
                <span>
                  {w.exercises.length} {t('ia.exerciseCount')}
                </span>
                <span>{t(`fitness.${w.status}`)}</span>
                {user && <span>{t(`common.${w.visibility}`)}</span>}
              </div>
            </div>
            <ArrowUpRight size={18} className="muted" />
          </a>
        ))}
      </div>
      {!visible.length && (
        <div class="card empty">
          <Dumbbell size={30} strokeWidth={1} />
          <p>{t('dashboard.noWorkout')}</p>
          {user && (
            <a href="/fitness" class="text-link">
              {t('fitness.quick')}
            </a>
          )}
        </div>
      )}
      <div class="form-actions">
        {page > 0 && (
          <a
            class="button button-secondary"
            href={`/fitness?view=history&page=${page - 1}${selected ? `&day=${selected}` : ''}`}
          >
            {t('common.previous')}
          </a>
        )}
        {filtered.length > (page + 1) * 20 && (
          <a
            class="button button-secondary"
            href={`/fitness?view=history&page=${page + 1}${selected ? `&day=${selected}` : ''}`}
          >
            {t('common.next')}
          </a>
        )}
      </div>
    </>
  )}
  {isView('library') && (
    <div class="card">
      <p class="small muted catalog-note">
        {catalogCount?.count.toLocaleString(locale)} {t('fitness.catalogCount')}
      </p>
      <ExerciseSearch locale={locale} preferences={preferences} owner={!!user} client:load />
    </div>
  )}
  {isView('templates') && user && (
    <Templates
      preferences={preferences}
      locale={locale}
      initial={await listTemplates(user.id)}
      client:load
    />
  )}
  {isView('analytics') && (
    <>
      <div class="card">
        <div class="stats">
          <div class="stat">
            <strong>{summary.weekCount}</strong>
            <span>{t('dashboard.week')}</span>
          </div>
          <div class="stat">
            <strong>{summary.monthCount}</strong>
            <span>{t('dashboard.month')}</span>
          </div>
          <div class="stat">
            <strong>{summary.durationKnown ? Math.round(summary.totalSeconds / 60) : '—'}</strong>
            <span>
              {t('dashboard.duration')} · {t('common.minutes')}
            </span>
          </div>
          <div class="stat">
            <strong>
              {summary.volumeKnown
                ? Math.round(
                    toDisplayWeight(summary.totalVolume, preferences.weightUnit),
                  ).toLocaleString(locale)
                : '—'}
            </strong>
            <span>
              {t('dashboard.volume')} · {preferences.weightUnit}
            </span>
          </div>
        </div>
        <hr class="rule" />
        <div class="stats-inline">
          <span class="small muted">
            {t('dashboard.streak')}: {summary.current} {t('common.days')}
          </span>
          <span class="small muted">
            {t('fitness.longest')}: {summary.longest} {t('common.days')}
          </span>
        </div>
        <p class="footer-note">{t('simple.recordedOnly')}</p>
      </div>
      <div class="analytics-grid">
        <section class="card">
          <div class="card-heading">
            <h2>{t('fitness.muscles')}</h2>
          </div>
          <nav class="section-tabs">
            {[7, 30].map((n) => (
              <a class:list={{ active: period === n }} href={`/fitness?view=analytics&period=${n}`}>
                {t(n === 7 ? 'fitness.last7' : 'fitness.last30')}
              </a>
            ))}
          </nav>
          {muscles.length ? (
            muscles.map((m) => (
              <div class="bar-row">
                <header>
                  <span>{taxonomyLabel(m.muscle, locale)}</span>
                  <span class="muted">
                    {m.sets} {t('fitness.set')}
                  </span>
                </header>
                <ProgressBar
                  value={m.sets}
                  max={Math.max(...muscles.map((x) => x.sets))}
                  aria-label={taxonomyLabel(m.muscle, locale)}
                />
              </div>
            ))
          ) : (
            <p class="muted small">{t('fitness.noStats')}</p>
          )}
        </section>
        <section class="card">
          <div class="card-heading">
            <h2>{t('fitness.pr')}</h2>
          </div>
          {records.length ? (
            records.map((r) => (
              <div class="recent-row">
                <div class="recent-info">
                  <h3>{exerciseName(r, locale)}</h3>
                  <p class="small muted">
                    {t('fitness.estimated')}:{' '}
                    {r.estimated
                      ? toDisplayWeight(r.estimated, preferences.weightUnit).toFixed(1)
                      : '—'}{' '}
                    {preferences.weightUnit}
                  </p>
                  <p class="small muted">
                    {dayKey(r.date, preferences.timezone)}
                    {r.increase > 0
                      ? ` · +${toDisplayWeight(r.increase, preferences.weightUnit).toFixed(1)} ${preferences.weightUnit}`
                      : ''}
                  </p>
                </div>
                <strong class="mono">
                  {toDisplayWeight(r.weight, preferences.weightUnit).toFixed(1)}{' '}
                  {preferences.weightUnit}
                </strong>
              </div>
            ))
          ) : (
            <p class="muted small">{t('fitness.noStats')}</p>
          )}
        </section>
      </div>
    </>
  )}
</Base>
