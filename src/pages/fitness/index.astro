---
import { fitnessOverview } from '../../server/services/fitness-overview';
import { ProgressBar } from '../../components/ui/progress-bar';
import Base from '../../layouts/Base.astro';
import QuickCheckin from '../../features/fitness/QuickCheckin';
import { trainingParts } from '../../lib/fitness-recording';
import WorkoutActions from '../../features/fitness/WorkoutActions';
import ExerciseSearch from '../../features/fitness/ExerciseSearch';
import HistoryCalendar from '../../features/fitness/HistoryCalendar';
import Templates from '../../features/fitness/Templates';
import { translator, exerciseName, taxonomyLabel } from '../../lib/i18n';
import {
  dayKey,
  workoutDay,
  knownWorkoutSeconds,
  shiftDay,
  fitnessSummary,
  workoutSeconds,
  workoutVolume,
  personalRecords,
  muscleDistribution,
  toDisplayWeight,
} from '../../lib/analytics';
import { listWorkouts, listTemplates } from '../../server/services/fitness';
import { ArrowUpRight, Dumbbell } from 'lucide-react';
const { locale, preferences, user } = Astro.locals,
  t = translator(locale);
const view =
    Astro.url.searchParams.get('view') ?? (Astro.url.searchParams.has('day') ? 'history' : 'today'),
  selected = Astro.url.searchParams.get('day') ?? undefined;
const catalogCount =
  view === 'library'
    ? await (
        await import('../../server/db')
      ).first<{ count: number }>('SELECT COUNT(*) count FROM exercise_library WHERE active=1')
    : null;
const overview = view === 'today' ? await fitnessOverview(user, preferences) : null;
const workouts = overview
    ? overview.workouts
    : ['history', 'analytics'].includes(view)
      ? await listWorkouts(user)
      : [],
  summary = fitnessSummary(workouts, preferences);
const filtered = selected
  ? workouts.filter((w) => workoutDay(w, preferences.timezone) === selected)
  : workouts;
const page = Math.max(0, Number(Astro.url.searchParams.get('page')) || 0),
  visible = filtered.slice(page * 20, page * 20 + 20);
const days: Record<
  string,
  {
    count: number;
    minutes: number;
    durationKnown?: boolean;
    volume: number;
    sets: number;
    exercises: number;
  }
> = {};
for (const w of (view === 'history' ? workouts : []).filter((w) => w.status === 'completed')) {
  const key = workoutDay(w, preferences.timezone),
    current = days[key] ?? { count: 0, minutes: 0, volume: 0, sets: 0, exercises: 0 };
  days[key] = {
    count: current.count + 1,
    minutes: current.minutes + workoutSeconds(w) / 60,
    durationKnown: !!current.durationKnown || knownWorkoutSeconds(w) !== null,
    volume: current.volume + workoutVolume(w),
    sets:
      current.sets + w.exercises.reduce((n, e) => n + e.sets.filter((s) => s.completed).length, 0),
    exercises: current.exercises + w.exercises.length,
  };
}
const usage = new Map<string, { count: number; last: string }>();
if (view === 'today' && user)
  for (const w of workouts) {
    const date = workoutDay(w, preferences.timezone);
    if (w.status !== 'completed' || date < shiftDay(summary.today, -89) || date > summary.today)
      continue;
    for (const part of w.body_parts) {
      const prev = usage.get(part);
      usage.set(part, {
        count: (prev?.count ?? 0) + 1,
        last: (prev?.last ?? '') > w.start_at ? prev!.last : w.start_at,
      });
    }
  }
const commonItems = [...trainingParts].sort(
  (a, b) =>
    (usage.get(b)?.count ?? 0) - (usage.get(a)?.count ?? 0) ||
    (usage.get(b)?.last ?? '').localeCompare(usage.get(a)?.last ?? ''),
);
const unfinished = workouts.filter((w) => w.status !== 'completed');
const isView = (name: string) => view === name;
const period = Astro.url.searchParams.get('period') === '7' ? 7 : 30;
const muscles =
    view === 'analytics' ? muscleDistribution(workouts, preferences.timezone, period) : [],
  records = view === 'analytics' ? personalRecords(workouts) : [];
---

<Base title={t('nav.fitness')} active="fitness">
  <header class="page-header">
    <div>
      <h1>{t('fitness.title')}</h1>
    </div>
  </header>
  {user && workouts.filter((w) => w.status !== 'completed').length > 0 && (
    <section class="resume-list" aria-label={t('record.resume')}>
      {workouts
        .filter((w) => w.status !== 'completed')
        .slice(0, Astro.url.searchParams.get('unfinished') === '1' ? undefined : 1)
        .map((w) => (
          <a class="resume-entry" href={`/fitness/${w.id}`}>
            <span>
              {w.title} · {t(`fitness.${w.status}`)}
            </span>
            <strong>{t('record.resume')} →</strong>
          </a>
        ))}
      {unfinished.length > 1 && (
        <a class="text-link" href="/fitness?unfinished=1">
          {t('simple.allActive')} ({unfinished.length})
        </a>
      )}
    </section>
  )}

  <nav class="section-tabs" aria-label={t('fitness.title')}>
    {(['today', 'history', 'library'] as const).map((v) => (
      <a
        href={`/fitness?view=${v}`}
        class:list={{ active: view === v }}
        aria-current={view === v ? 'page' : undefined}
      >
        {t(`fitness.${v}`)}
      </a>
    ))}
  </nav>
  {(isView('history') || isView('analytics')) && (
    <div class="secondary-links">
      <a
        class="text-link"
        href={isView('analytics') ? '/fitness?view=history' : '/fitness?view=analytics'}
      >
        {t(isView('analytics') ? 'fitness.history' : 'fitness.analytics')}{' '}
        <ArrowUpRight size={15} />
      </a>
    </div>
  )}
  {isView('templates') && <h2 class="section-title">{t('fitness.templates')}</h2>}
  {isView('today') && (
    <>
      {user && (
        <QuickCheckin
          locale={locale}
          preferences={preferences}
          today={summary.today}
          order={commonItems}
          initialDay={{
            date: summary.today,
            items: summary.todayWorkouts,
            current:
              summary.todayWorkouts.toSorted(
                (a, b) =>
                  b.updated_at.localeCompare(a.updated_at) ||
                  b.start_at.localeCompare(a.start_at) ||
                  b.id.localeCompare(a.id),
              )[0] ?? null,
            weekCount: summary.weekCount,
            recent: overview!.recent,
          }}
          weekStart={summary.weekStart}
          feedbackScope={user.id}
          client:load
        />
      )}
      {!user && (
        <p class="muted">
          {t('dashboard.week')}: {summary.weekCount}
        </p>
      )}
      {user && (
        <div class="daily-start">
          <WorkoutActions locale={locale} preferences={preferences} client:load />
        </div>
      )}
      {!user && (
        <section class="daily-recent">
          <div class="card-heading">
            <h2>{t('simple.recent')}</h2>
            <a class="text-link" href="/fitness?view=history">
              {t('common.all')} →
            </a>
          </div>
          {workouts
            .filter((w) => w.status === 'completed')
            .slice(0, 5)
            .map((w) => (
              <a class="resume-entry" href={`/fitness/${w.id}`}>
                <span>
                  <strong>{w.title}</strong>
                  <span class="muted small"> · {workoutDay(w, preferences.timezone)}</span>
                </span>
                <span class="muted small">
                  {knownWorkoutSeconds(w) !== null
                    ? `${Math.round(workoutSeconds(w) / 60)} ${t('common.minutes')}`
                    : t('fitness.completed')}{' '}
                  →
                </span>
              </a>
            ))}
          {!workouts.some((w) => w.status === 'completed') && (
            <p class="muted">{t('dashboard.noWorkout')}</p>
          )}
        </section>
      )}
    </>
  )}
  {isView('history') && (
    <>
      <HistoryCalendar
        locale={locale}
        weekStart={preferences.weekStart}
        today={summary.today}
        days={days}
        selected={selected}
        client:visible
      />
      {selected && (
        <div class="card-heading">
          <h2>{selected}</h2>
          <a class="text-link" href="/fitness?view=history">
            {t('common.all')}
          </a>
        </div>
      )}
      <div class="workout-list">
        {visible.map((w) => (
          <a class="workout-card card-link" href={`/fitness/${w.id}`}>
            <span class="workout-date">
              <strong>
                {new Intl.DateTimeFormat(locale, {
                  day: 'numeric',
                  timeZone: preferences.timezone,
                }).format(new Date(w.start_at))}
              </strong>
              <span>
                {new Intl.DateTimeFormat(locale, {
                  month: 'short',
                  timeZone: preferences.timezone,
                }).format(new Date(w.start_at))}
              </span>
            </span>
            <div class="workout-content">
              <h3>{w.title}</h3>
              <div class="workout-meta">
                <span>
                  {knownWorkoutSeconds(w) === null
                    ? t('simple.notRecorded')
                    : `${Math.round(workoutSeconds(w) / 60)} ${t('common.minutes')}`}
                </span>
                <span>
                  {w.exercises.length} {t('fitness.library')}
                </span>
                <span>{t(`fitness.${w.status}`)}</span>
                {user && <span>{t(`common.${w.visibility}`)}</span>}
              </div>
            </div>
            <ArrowUpRight size={18} className="muted" />
          </a>
        ))}
      </div>
      {!visible.length && (
        <div class="card empty">
          <Dumbbell size={30} strokeWidth={1} />
          <p>{t('dashboard.noWorkout')}</p>
          {user && (
            <a href="/fitness" class="text-link">
              {t('fitness.quick')}
            </a>
          )}
        </div>
      )}
      <div class="form-actions">
        {page > 0 && (
          <a
            class="button button-secondary"
            href={`/fitness?view=history&page=${page - 1}${selected ? `&day=${selected}` : ''}`}
          >
            {t('common.previous')}
          </a>
        )}
        {filtered.length > (page + 1) * 20 && (
          <a
            class="button button-secondary"
            href={`/fitness?view=history&page=${page + 1}${selected ? `&day=${selected}` : ''}`}
          >
            {t('common.next')}
          </a>
        )}
      </div>
    </>
  )}
  {isView('library') && (
    <div class="card">
      <p class="small muted catalog-note">
        {catalogCount?.count.toLocaleString(locale)} {t('fitness.catalogCount')}
      </p>
      <ExerciseSearch locale={locale} preferences={preferences} owner={!!user} client:load />
    </div>
  )}
  {isView('templates') && user && (
    <Templates
      preferences={preferences}
      locale={locale}
      initial={await listTemplates(user.id)}
      client:load
    />
  )}
  {isView('analytics') && (
    <>
      <div class="card">
        <div class="stats">
          <div class="stat">
            <strong>{summary.weekCount}</strong>
            <span>{t('dashboard.week')}</span>
          </div>
          <div class="stat">
            <strong>{summary.monthCount}</strong>
            <span>{t('dashboard.month')}</span>
          </div>
          <div class="stat">
            <strong>{summary.durationKnown ? Math.round(summary.totalSeconds / 60) : '—'}</strong>
            <span>
              {t('dashboard.duration')} · {t('common.minutes')}
            </span>
          </div>
          <div class="stat">
            <strong>
              {summary.volumeKnown
                ? Math.round(
                    toDisplayWeight(summary.totalVolume, preferences.weightUnit),
                  ).toLocaleString(locale)
                : '—'}
            </strong>
            <span>
              {t('dashboard.volume')} · {preferences.weightUnit}
            </span>
          </div>
        </div>
        <hr class="rule" />
        <div class="stats-inline">
          <span class="small muted">
            {t('dashboard.streak')}: {summary.current} {t('common.days')}
          </span>
          <span class="small muted">
            {t('fitness.longest')}: {summary.longest} {t('common.days')}
          </span>
        </div>
        <p class="footer-note">{t('simple.recordedOnly')}</p>
      </div>
      <div class="analytics-grid">
        <section class="card">
          <div class="card-heading">
            <h2>{t('fitness.muscles')}</h2>
          </div>
          <nav class="section-tabs">
            {[7, 30].map((n) => (
              <a class:list={{ active: period === n }} href={`/fitness?view=analytics&period=${n}`}>
                {t(n === 7 ? 'fitness.last7' : 'fitness.last30')}
              </a>
            ))}
          </nav>
          {muscles.length ? (
            muscles.map((m) => (
              <div class="bar-row">
                <header>
                  <span>{taxonomyLabel(m.muscle, locale)}</span>
                  <span class="muted">
                    {m.sets} {t('fitness.set')}
                  </span>
                </header>
                <ProgressBar
                  value={m.sets}
                  max={Math.max(...muscles.map((x) => x.sets))}
                  aria-label={taxonomyLabel(m.muscle, locale)}
                />
              </div>
            ))
          ) : (
            <p class="muted small">{t('fitness.noStats')}</p>
          )}
        </section>
        <section class="card">
          <div class="card-heading">
            <h2>{t('fitness.pr')}</h2>
          </div>
          {records.length ? (
            records.map((r) => (
              <div class="recent-row">
                <div class="recent-info">
                  <h3>{exerciseName(r, locale)}</h3>
                  <p class="small muted">
                    {t('fitness.estimated')}:{' '}
                    {r.estimated
                      ? toDisplayWeight(r.estimated, preferences.weightUnit).toFixed(1)
                      : '—'}{' '}
                    {preferences.weightUnit}
                  </p>
                  <p class="small muted">
                    {dayKey(r.date, preferences.timezone)}
                    {r.increase > 0
                      ? ` · +${toDisplayWeight(r.increase, preferences.weightUnit).toFixed(1)} ${preferences.weightUnit}`
                      : ''}
                  </p>
                </div>
                <strong class="mono">
                  {toDisplayWeight(r.weight, preferences.weightUnit).toFixed(1)}{' '}
                  {preferences.weightUnit}
                </strong>
              </div>
            ))
          ) : (
            <p class="muted small">{t('fitness.noStats')}</p>
          )}
        </section>
      </div>
    </>
  )}
</Base>
