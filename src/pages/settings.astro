---
import Base from '../layouts/Base.astro';
import SettingsPanel from '../features/settings/SettingsPanel';
import { getWidgets } from '../server/services/settings';
import { translator } from '../lib/i18n';
const t = translator(Astro.locals.locale);
---

<Base title={t('nav.settings')} active="settings">
  <header class="page-header">
    <div>
      <span class="eyebrow">PREFERENCES</span>
      <h1>{t('settings.title')}</h1>
      <p>{t('settings.subtitle')}</p>
    </div>
  </header>
  <SettingsPanel
    locale={Astro.locals.locale}
    initial={Astro.locals.preferences}
    initialWidgets={await getWidgets()}
    owner={!!Astro.locals.user}
    client:load
  />
</Base>
