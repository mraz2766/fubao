---
import Base from '../layouts/Base.astro';
import SettingsPanel from '../features/settings/SettingsPanel';
import { getWidgets } from '../server/services/settings';
import { translator } from '../lib/i18n';
const t = translator(Astro.locals.locale);
---

<Base title={t('nav.settings')} active="settings">
  <header class="page-header">
    <div>
      <h1>{t('settings.title')}</h1>
    </div>
  </header>
  <SettingsPanel
    locale={Astro.locals.locale}
    initial={{ ...Astro.locals.preferences, language: Astro.locals.locale }}
    initialWidgets={await getWidgets(Astro.locals.user?.id)}
    owner={!!Astro.locals.user}
    username={Astro.locals.user?.username}
    client:load
  />
  <section class="install-guide">
    <h2>{Astro.locals.locale === 'zh-CN' ? '添加到主屏幕' : 'Add to Home Screen'}</h2>
    <p>
      {Astro.locals.locale === 'zh-CN'
        ? '在 iPhone Safari 中轻点分享，选择“添加到主屏幕”。从 Fubao 图标打开，即可使用独立 App 窗口。'
        : 'In iPhone Safari, tap Share, then Add to Home Screen. Open the Fubao icon for a standalone app window.'}
    </p>
  </section>
</Base>
