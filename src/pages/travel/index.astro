---
import TravelScroll from '../../components/TravelScroll.astro';
import Discover from '../../features/travel/Discover';
import ChinaMap from '../../features/travel/ChinaMap.astro';
import Base from '../../layouts/Base.astro';
import TravelGallery from '../../features/travel/TravelGallery.astro';
import InteractiveMap from '../../features/travel/InteractiveMap';
import Wishlist from '../../features/travel/Wishlist';
import PhotoWall from '../../features/travel/PhotoWall';

import {
  listTrips,
  listWishlist,
  visitedSpotIds,
  travelCounts,
  photoPage,
} from '../../server/services/travel';
import { translator } from '../../lib/i18n';

const { user, locale } = Astro.locals,
  t = translator(locale);
const view = Astro.url.searchParams.get('view') ?? 'timeline';
const page = Math.max(0, Number(Astro.url.searchParams.get('page')) || 0);
const [trips, wishes, visitedIds, counts, photos] = await Promise.all([
  view === 'map'
    ? listTrips(user)
    : view === 'timeline'
      ? listTrips(user, undefined, { limit: 13, offset: page * 12 })
      : Promise.resolve([]),
  ['map', 'wishlist', 'discover'].includes(view) ? listWishlist(user) : Promise.resolve([]),
  view === 'discover' ? visitedSpotIds(user) : Promise.resolve([]),
  view === 'photos' ? travelCounts(user) : Promise.resolve({ trips: 0, places: 0 }),
  view === 'photos'
    ? photoPage(user, locale, page * 24)
    : Promise.resolve({ items: [], hasMore: false }),
]);
const world =
  view === 'map' && Astro.url.searchParams.get('scope') === 'world'
    ? await import('../../features/travel/map-data')
    : null;
const isView = (v: string) => view === v;
const placeCount = counts.places;
const visible = trips.slice(0, 12);
const wall = photos.items;
---

<Base title={t('nav.travel')} active="travel">
  <header class="page-header">
    <div>
      <h1>{t('travel.title')}</h1>
    </div>
    {user && (
      <a class="button button-primary" href="/travel/new">
        + {t('ia.newTrip')}
      </a>
    )}
  </header>
  <details class="view-menu travel-view-menu">
    <summary>{t('simple.more')}</summary>
    <nav class="secondary-links">
      {(
        [
          ['timeline', 'travel.timeline'],
          ['photos', 'travel.photos'],
          ['map', 'travel.map'],
          ['wishlist', 'travel.wishlist'],
          ['discover', 'travel.discover'],
        ] as const
      ).map(([v, label]) => (
        <a class="text-link" href={`/travel?view=${v}`}>
          {t(label)}
        </a>
      ))}
    </nav>
  </details>
  {isView('timeline') && <TravelGallery locale={locale} initial={visible} />}
  {!isView('timeline') && (
    <a class="text-link" href="/travel">
      ← {t('travel.title')}
    </a>
  )}
  {isView('photos') && counts.trips > 0 && (
    <p class="travel-summary small muted">
      {placeCount} {t('quiet.places')} · {counts.trips} {t('travel.trips')}
    </p>
  )}
  {isView('discover') && (
    <Discover
      locale={locale}
      owner={!!user}
      initialWishes={wishes}
      visitedIds={visitedIds}
      selectedId={Astro.url.searchParams.get('spot') ?? undefined}
      client:load
    />
  )}
  {isView('map') &&
    (Astro.url.searchParams.get('scope') === 'world' ? (
      <>
        {' '}
        <section class="card">
          <InteractiveMap
            locale={locale}
            countries={world!.mapCountries}
            entries={world!.mapEntries(trips, locale)}
            wishes={wishes.map((w) => w.location.country_code)}
            client:visible
          />
        </section>
        <a class="text-link" href="/travel?view=map">
          {t('travel.chinaMap')} ↗
        </a>
      </>
    ) : (
      <ChinaMap locale={locale} trips={trips} wishes={wishes} />
    ))}
  {isView('photos') && <PhotoWall locale={locale} photos={wall} client:visible />}
  {isView('wishlist') && (
    <div class="card">
      <Wishlist locale={locale} initial={wishes} owner={!!user} client:visible />
    </div>
  )}
  {(isView('timeline') || isView('photos')) && (
    <div class="form-actions">
      {page > 0 && (
        <a class="button button-secondary" href={`/travel?view=${view}&page=${page - 1}`}>
          {t('common.previous')}
        </a>
      )}
      {(isView('photos') ? photos.hasMore : trips.length > 12) && (
        <a class="button button-secondary" href={`/travel?view=${view}&page=${page + 1}`}>
          {t('common.next')}
        </a>
      )}
    </div>
  )}
<TravelScroll /></Base>
