---
import FormViewport from '../../components/FormViewport.astro';
import Base from '../../layouts/Base.astro';
import TravelFormPage from '../../features/travel/TravelFormPage';
import { translator } from '../../lib/i18n';
const { user, locale } = Astro.locals;
if (!user) return Astro.redirect('/login');
const t = translator(locale);
---

<Base title={t('ia.newTrip')} active="travel">
  <a class="text-link" href="/travel">
    ← {t('nav.travel')}
  </a>
  <header class="page-header">
    <h1>{t('ia.newTrip')}</h1>
  </header>
  <TravelFormPage locale={locale} client:load />
<FormViewport /></Base>
