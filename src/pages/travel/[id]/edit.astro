---
import FormViewport from '../../../components/FormViewport.astro';
import Base from '../../../layouts/Base.astro';
import TravelFormPage from '../../../features/travel/TravelFormPage';
import { listTrips } from '../../../server/services/travel';
import { translator } from '../../../lib/i18n';
const { user, locale } = Astro.locals;
if (!user) return Astro.redirect('/login');
const initial = (await listTrips(user, Astro.params.id))[0],
  t = translator(locale);
if (!initial) return Astro.redirect('/404');
---

<Base title={t('ia.editTrip')} active="travel">
  <a class="text-link" href={`/travel/${initial.id}`}>
    ← {t('nav.travel')}
  </a>
  <header class="page-header">
    <h1>{t('ia.editTrip')}</h1>
  </header>
  <TravelFormPage locale={locale} initial={initial} client:load />
<FormViewport /></Base>
