---
import Base from '../layouts/Base.astro';
import { translator } from '../lib/i18n';
import Dashboard from '../features/dashboard/Dashboard.astro';
import { greetingAt } from '../features/dashboard/presentation';
import StoryIcon from '../components/illustrations/StoryIcon';
import { fitnessOverview } from '../server/services/fitness-overview';
import { getWidgets } from '../server/services/settings';
import { listTrips, travelCounts } from '../server/services/travel';
const t = translator(Astro.locals.locale);
const [overview, widgets, trips, counts] = await Promise.all([
  fitnessOverview(Astro.locals.user, Astro.locals.preferences, 31),
  getWidgets(),
  listTrips(Astro.locals.user, undefined, { limit: 2 }),
  travelCounts(Astro.locals.user),
]);
const now = new Date();
const greeting = greetingAt(now, Astro.locals.preferences.timezone);
---

<Base title={t('nav.home')}>
  <header class="page-header home-header">
    <div>
      <span class="eyebrow">
        {new Intl.DateTimeFormat(Astro.locals.locale, {
          month: 'short',
          day: 'numeric',
          timeZone: Astro.locals.preferences.timezone,
        }).format(now)}{' '}
        ·{' '}
        {new Intl.DateTimeFormat(Astro.locals.locale, {
          weekday: 'short',
          timeZone: Astro.locals.preferences.timezone,
        }).format(now)}
      </span>
      <h1>
        <span class="greeting-icon" data-time={greeting}>
          <StoryIcon kind={greeting === 'evening' ? 'moon' : 'sun'} size={32} />
        </span>
        {t(`dashboard.${greeting}`)}
      </h1>
      <p class="greeting-note">{t('story.greeting')}</p>
    </div>
  </header>
  <Dashboard
    places={counts.places}
    workouts={overview.workouts}
    trips={trips}
    widgets={widgets}
    preferences={Astro.locals.preferences}
    locale={Astro.locals.locale}
    owner={!!Astro.locals.user}
    feedbackScope={Astro.locals.user?.id ?? 'public'}
  />
</Base>
